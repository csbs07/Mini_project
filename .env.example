# OpenAlex polite pool contact email
OPENALEX_MAILTO=researcher@example.com

# LLM API configuration (Groq)
GROQ_API_KEY=
LLM_API_KEY=
LLM_CHAT_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# Full-text & Chatbot session settings
CHAT_SESSION_COST_CAP_USD=1.00
CHAT_MAX_UPLOADS_PER_SESSION=5
CHAT_MAX_MESSAGE_CHARS=2000
HOST_ALLOWLIST=
EMBEDDING_MODEL=all-MiniLM-L6-v2
AUTH_SECRET_KEY=change-this-to-a-secure-random-key-in-production
GITHUB_RELEVANCE_THRESHOLD=2.5
